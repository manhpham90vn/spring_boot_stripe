{
  // =========================================================================
  // Chạy từng service Spring Boot bằng Java extension (Run/Debug).
  // - Mỗi service 1 cấu hình; "preLaunchTask" bật hạ tầng docker trước.
  // - Port host gán sẵn (kể cả khi service chưa có web) để sau không đụng nhau,
  //   tránh trùng port tooling: kafka-ui 8085, pgadmin 5050, redisinsight 5540.
  // - Biến môi trường trỏ tới hạ tầng compose (Postgres/Redis/Kafka trên host).
  //   Service-per-DB: mỗi service trỏ đúng database của mình.
  // - "Tất cả service" (compound) chạy đồng loạt cả 9.
  // Yêu cầu: cài extension "Extension Pack for Java".
  // =========================================================================
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "apigateway",
      "request": "launch",
      "mainClass": "com.example.apigateway.ApigatewayApplication",
      "projectName": "apigateway",
      "preLaunchTask": "infra: up",
      "args": ["--server.port=8080"],
      "env": {
        "SPRING_DATA_REDIS_HOST": "localhost",
        "SPRING_DATA_REDIS_PORT": "6379"
      }
    },
    {
      "type": "java",
      "name": "auth",
      "request": "launch",
      "mainClass": "com.manhpham.auth.AuthApplication",
      "projectName": "auth",
      "preLaunchTask": "infra: up",
      "args": ["--server.port=8081"],
      "env": {
        "SPRING_DATASOURCE_URL": "jdbc:postgresql://localhost:5432/auth",
        "SPRING_DATASOURCE_USERNAME": "app",
        "SPRING_DATASOURCE_PASSWORD": "app"
      }
    },
    {
      "type": "java",
      "name": "catalog",
      "request": "launch",
      "mainClass": "com.manhpham.catalog.CatalogApplication",
      "projectName": "catalog",
      "preLaunchTask": "infra: up",
      "args": ["--server.port=8082"],
      "env": {
        "SPRING_DATASOURCE_URL": "jdbc:postgresql://localhost:5432/catalog",
        "SPRING_DATASOURCE_USERNAME": "app",
        "SPRING_DATASOURCE_PASSWORD": "app",
        "SPRING_DATA_REDIS_HOST": "localhost",
        "SPRING_DATA_REDIS_PORT": "6379"
      }
    },
    {
      "type": "java",
      "name": "inventory",
      "request": "launch",
      "mainClass": "com.manhpham.inventory.InventoryApplication",
      "projectName": "inventory",
      "preLaunchTask": "infra: up",
      "args": ["--server.port=8083"],
      "env": {
        "SPRING_DATASOURCE_URL": "jdbc:postgresql://localhost:5432/inventory",
        "SPRING_DATASOURCE_USERNAME": "app",
        "SPRING_DATASOURCE_PASSWORD": "app",
        "SPRING_DATA_REDIS_HOST": "localhost",
        "SPRING_DATA_REDIS_PORT": "6379"
      }
    },
    {
      "type": "java",
      "name": "order",
      "request": "launch",
      "mainClass": "com.manhpham.order.OrderApplication",
      "projectName": "order",
      "preLaunchTask": "infra: up",
      "args": ["--server.port=8084"],
      "env": {
        "SPRING_DATASOURCE_URL": "jdbc:postgresql://localhost:5432/order",
        "SPRING_DATASOURCE_USERNAME": "app",
        "SPRING_DATASOURCE_PASSWORD": "app",
        "SPRING_KAFKA_BOOTSTRAP_SERVERS": "localhost:9092"
      }
    },
    {
      "type": "java",
      "name": "payment",
      "request": "launch",
      "mainClass": "com.manhpham.payment.PaymentApplication",
      "projectName": "payment",
      "preLaunchTask": "infra: up",
      "args": ["--server.port=8086"],
      "env": {
        "SPRING_DATASOURCE_URL": "jdbc:postgresql://localhost:5432/payment",
        "SPRING_DATASOURCE_USERNAME": "app",
        "SPRING_DATASOURCE_PASSWORD": "app",
        "SPRING_KAFKA_BOOTSTRAP_SERVERS": "localhost:9092"
      }
    },
    {
      "type": "java",
      "name": "ticket",
      "request": "launch",
      "mainClass": "com.manhpham.ticket.TicketApplication",
      "projectName": "ticket",
      "preLaunchTask": "infra: up",
      "args": ["--server.port=8087"],
      "env": {
        "SPRING_DATASOURCE_URL": "jdbc:postgresql://localhost:5432/ticket",
        "SPRING_DATASOURCE_USERNAME": "app",
        "SPRING_DATASOURCE_PASSWORD": "app",
        "SPRING_KAFKA_BOOTSTRAP_SERVERS": "localhost:9092"
      }
    },
    {
      "type": "java",
      "name": "notification",
      "request": "launch",
      "mainClass": "com.manhpham.notification.NotificationApplication",
      "projectName": "notification",
      "preLaunchTask": "infra: up",
      "args": ["--server.port=8088"],
      "env": {
        "SPRING_KAFKA_BOOTSTRAP_SERVERS": "localhost:9092"
      }
    },
    {
      "type": "java",
      "name": "waitingroom",
      "request": "launch",
      "mainClass": "com.manhpham.waitingroom.WaitingroomApplication",
      "projectName": "waitingroom",
      "preLaunchTask": "infra: up",
      "args": ["--server.port=8089"],
      "env": {
        "SPRING_DATA_REDIS_HOST": "localhost",
        "SPRING_DATA_REDIS_PORT": "6379"
      }
    }
  ],
  "compounds": [
    {
      "name": "Tất cả service",
      "configurations": [
        "apigateway",
        "auth",
        "catalog",
        "inventory",
        "order",
        "payment",
        "ticket",
        "notification",
        "waitingroom"
      ],
      "preLaunchTask": "infra: up",
      "stopAll": true
    }
  ]
}
